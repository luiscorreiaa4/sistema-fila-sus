{
  "name": "sistema-fila-sus-backend",
  "version": "1.0.0",
  "description": "Backend Node.js + TypeScript + Prisma ORM do Sistema de Transparencia de Filas Publicas (SUS)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:setup": "tsx src/infrastructure/database/setup.ts && prisma generate",
    "db:apply-3af": "psql -U postgres -p 5437 -d filas_sus -f ../sql/estrutura_3af.sql",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/domain/__tests__/domain.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.23.1",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
